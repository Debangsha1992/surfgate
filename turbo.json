{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["eslint.config.mjs", "tsconfig.base.json", "vitest.config.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build", "^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "NODE_ENV",
        "SURFGATE_RELAY_PUBLIC_URL",
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "REDIS_URL",
        "S3_REGION",
        "S3_BUCKET",
        "SURFGATE_PROVIDER_SESSION_ENCRYPTION_KEY",
        "SURFGATE_RELAY_TOKEN_SIGNING_KEY"
      ]
    },
    "test:conformance": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
