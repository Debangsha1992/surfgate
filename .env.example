# SurfGate local development. Copy to .env; never commit real credentials.
# Advanced limits retain safe defaults and normally do not need changing.

# Local core
# NODE_ENV is process-only and defaults to development when unset.
LOG_LEVEL=info

# API control plane
SURFGATE_API_HOST=127.0.0.1
SURFGATE_API_PORT=8080
SURFGATE_QUOTA_REQUESTS_PER_MINUTE=60
SURFGATE_QUOTA_MAX_CONCURRENT_SESSIONS=10
SURFGATE_QUOTA_MAX_SESSION_DURATION_SECONDS=600
SURFGATE_PROVIDER_HEALTH_TIMEOUT_MS=5000
SURFGATE_PROVIDER_ALLOCATION_TIMEOUT_MS=30000
SURFGATE_PROVIDER_TERMINATION_TIMEOUT_MS=15000
SURFGATE_IDEMPOTENCY_WAIT_TIMEOUT_MS=35000
SURFGATE_RECONCILIATION_STALE_AFTER_MS=120000
SURFGATE_RECONCILIATION_BATCH_SIZE=100

# Relay data plane
SURFGATE_RELAY_HOST=127.0.0.1
SURFGATE_RELAY_PORT=8081
SURFGATE_RELAY_PUBLIC_URL=ws://127.0.0.1:8081
SURFGATE_RELAY_TOKEN_TTL_SECONDS=60
SURFGATE_RELAY_CONNECT_TIMEOUT_MS=10000
SURFGATE_RELAY_IDLE_TIMEOUT_MS=60000
SURFGATE_RELAY_ABSOLUTE_TIMEOUT_MS=3600000
SURFGATE_RELAY_MAX_MESSAGE_BYTES=8388608
SURFGATE_RELAY_MAX_QUEUED_BYTES=16777216
SURFGATE_RELAY_LEASE_TTL_MS=15000
SURFGATE_RELAY_AUTHORIZATION_CHECK_INTERVAL_MS=2000
SURFGATE_RELAY_DRAIN_TIMEOUT_MS=10000

# Worker and managed tasks
SURFGATE_WORKER_HEALTH_HOST=127.0.0.1
SURFGATE_WORKER_HEALTH_PORT=8082
SURFGATE_WORKER_READINESS_TIMEOUT_MS=5000
SURFGATE_WORKER_DRAIN_TIMEOUT_MS=10000
SURFGATE_TASK_REQUESTS_PER_MINUTE=120
SURFGATE_TASK_MAX_QUEUED_PER_TENANT=100
SURFGATE_TASK_MAX_RUNNING_PER_TENANT=5
SURFGATE_TASK_MAX_ATTEMPTS=3
SURFGATE_TASK_EXECUTION_TIMEOUT_MS=30000
SURFGATE_TASK_LEASE_TTL_MS=60000
SURFGATE_TASK_POLL_INTERVAL_MS=250
SURFGATE_TASK_EXTRACT_MAX_BYTES=1048576
SURFGATE_TASK_ARTIFACT_MAX_BYTES=16777216
SURFGATE_TASK_SCREENSHOT_MAX_PIXELS=33554432
SURFGATE_TASK_ARTIFACT_RETENTION_SECONDS=86400

# PostgreSQL (local placeholder credentials from docker-compose.dev.yml)
DATABASE_URL=postgresql://surfgate:surfgate@127.0.0.1:5432/surfgate
# Optional integration-test database; its name must end in _test.
TEST_DATABASE_URL=

# Redis (local docker-compose.dev.yml)
REDIS_URL=redis://127.0.0.1:6379

# Security keys — generate two distinct base64-encoded 32-byte values.
SURFGATE_PROVIDER_SESSION_ENCRYPTION_KEY=
SURFGATE_PROVIDER_SESSION_ENCRYPTION_KEY_ID=v1
SURFGATE_PROVIDER_SESSION_ENCRYPTION_PREVIOUS_KEY=
SURFGATE_PROVIDER_SESSION_ENCRYPTION_PREVIOUS_KEY_ID=
SURFGATE_RELAY_TOKEN_SIGNING_KEY=
SURFGATE_RELAY_TOKEN_SIGNING_KEY_ID=v1
SURFGATE_RELAY_TOKEN_SIGNING_PREVIOUS_KEY=
SURFGATE_RELAY_TOKEN_SIGNING_PREVIOUS_KEY_ID=
# Development/test defaults to trusted. Production defaults to disabled.
SURFGATE_RAW_CDP_ACCESS=

# Private S3-compatible object storage (required by the worker)
S3_REGION=auto
S3_BUCKET=surfgate-dev
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cloudflare Browser Run (required only for live provider allocation/tests)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BROWSER_RUN_API_TOKEN=
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4

# OpenTelemetry (export is disabled when the endpoint is empty)
OTEL_SERVICE_NAME=surfgate
OTEL_EXPORTER_OTLP_ENDPOINT=
SURFGATE_OTEL_EXPORT_INTERVAL_MS=10000
SURFGATE_OTEL_EXPORT_TIMEOUT_MS=5000
SURFGATE_OTEL_SHUTDOWN_TIMEOUT_MS=5000
SURFGATE_OTEL_MAX_QUEUE_SIZE=2048
SURFGATE_OTEL_MAX_EXPORT_BATCH_SIZE=512
SURFGATE_OTEL_METRIC_CARDINALITY_LIMIT=128

# Production-only settings
# Production validation requires secure remote dependency URLs, explicit key IDs,
# Cloudflare credentials, and the documented raw-CDP trust/egress decision. See
# operations/production-readiness.md and docs/SECURITY_MODEL.md; do not copy development values.
