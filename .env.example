# Local development only. Copy this file to .env; never commit real credentials.
# NODE_ENV is process-only and defaults to development when it is unset.
LOG_LEVEL=info

# API control plane
SURFGATE_API_HOST=127.0.0.1
SURFGATE_API_PORT=8080

# Relay data plane
SURFGATE_RELAY_HOST=127.0.0.1
SURFGATE_RELAY_PORT=8081
SURFGATE_RELAY_PUBLIC_URL=ws://127.0.0.1:8081
SURFGATE_RELAY_TOKEN_TTL_SECONDS=60
SURFGATE_RELAY_CONNECT_TIMEOUT_MS=10000
SURFGATE_RELAY_IDLE_TIMEOUT_MS=60000
SURFGATE_RELAY_ABSOLUTE_TIMEOUT_MS=3600000
SURFGATE_RELAY_MAX_MESSAGE_BYTES=8388608
SURFGATE_RELAY_MAX_QUEUED_BYTES=16777216
SURFGATE_RELAY_LEASE_TTL_MS=15000
SURFGATE_RELAY_AUTHORIZATION_CHECK_INTERVAL_MS=2000
SURFGATE_RELAY_DRAIN_TIMEOUT_MS=10000

# Local infrastructure from docker-compose.dev.yml
DATABASE_URL=postgresql://surfgate:surfgate@127.0.0.1:5432/surfgate
# Optional; required only by explicit database integration-test commands. Must name a *_test database.
TEST_DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379

# Session control-plane limits and bounded provider operations
SURFGATE_QUOTA_REQUESTS_PER_MINUTE=60
SURFGATE_QUOTA_MAX_CONCURRENT_SESSIONS=10
SURFGATE_QUOTA_MAX_SESSION_DURATION_SECONDS=600
SURFGATE_PROVIDER_HEALTH_TIMEOUT_MS=5000
SURFGATE_PROVIDER_ALLOCATION_TIMEOUT_MS=30000
SURFGATE_PROVIDER_TERMINATION_TIMEOUT_MS=15000
SURFGATE_IDEMPOTENCY_WAIT_TIMEOUT_MS=35000

# Managed task worker, durable queue, and bounded outputs
SURFGATE_TASK_REQUESTS_PER_MINUTE=120
SURFGATE_TASK_MAX_QUEUED_PER_TENANT=100
SURFGATE_TASK_MAX_RUNNING_PER_TENANT=5
SURFGATE_TASK_MAX_ATTEMPTS=3
SURFGATE_TASK_EXECUTION_TIMEOUT_MS=30000
SURFGATE_TASK_LEASE_TTL_MS=60000
SURFGATE_TASK_POLL_INTERVAL_MS=250
SURFGATE_TASK_EXTRACT_MAX_BYTES=1048576
SURFGATE_TASK_ARTIFACT_MAX_BYTES=16777216
SURFGATE_TASK_SCREENSHOT_MAX_PIXELS=33554432
SURFGATE_TASK_ARTIFACT_RETENTION_SECONDS=86400

# Encrypts sensitive provider session references at rest. Generate 32 random bytes and encode as base64.
SURFGATE_PROVIDER_SESSION_ENCRYPTION_KEY=
SURFGATE_PROVIDER_SESSION_ENCRYPTION_KEY_ID=v1

# Signs short-lived SurfGate relay tokens. Generate 32 random bytes and encode as base64.
SURFGATE_RELAY_TOKEN_SIGNING_KEY=
SURFGATE_RELAY_TOKEN_SIGNING_KEY_ID=v1

# S3-compatible object storage
S3_REGION=auto
S3_BUCKET=surfgate-dev
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OpenTelemetry
OTEL_SERVICE_NAME=surfgate
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional. Both values are required together to enable the Kitesurf provider.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BROWSER_RUN_API_TOKEN=
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
